[
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "max",
                "constraint": 120
              }
            ],
            "level": "error"
          }
        ],
        "name": "title",
        "type": "string"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "The address of the post, e.g. /blogs/dubai-market-2026",
        "name": "slug",
        "type": "slug",
        "title": "URL slug"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "publishedAt",
        "type": "datetime",
        "title": "Publish date"
      },
      {
        "options": {
          "hotspot": true
        },
        "description": "Shown on the blog list and at the top of the post.",
        "fields": [
          {
            "description": "Describe the image for screen readers and search engines.",
            "name": "alt",
            "type": "string",
            "title": "Alt text"
          }
        ],
        "name": "coverImage",
        "type": "image",
        "title": "Cover image"
      },
      {
        "rows": 3,
        "validation": [
          {
            "rules": [
              {
                "flag": "max",
                "constraint": 300
              }
            ],
            "level": "error"
          }
        ],
        "description": "One or two sentences shown on the blog list.",
        "name": "excerpt",
        "type": "text"
      },
      {
        "of": [
          {
            "marks": {
              "annotations": [
                {
                  "fields": [
                    {
                      "validation": [
                        {
                          "rules": [
                            {
                              "flag": "uri",
                              "constraint": {
                                "options": {
                                  "scheme": [
                                    "/^http$/",
                                    "/^https$/",
                                    "/^mailto$/",
                                    "/^tel$/"
                                  ],
                                  "allowRelative": false,
                                  "relativeOnly": false,
                                  "allowCredentials": false
                                }
                              }
                            }
                          ],
                          "level": "error"
                        }
                      ],
                      "name": "href",
                      "type": "url",
                      "title": "URL"
                    }
                  ],
                  "name": "link",
                  "type": "object"
                }
              ],
              "decorators": [
                {
                  "value": "strong",
                  "title": "Bold"
                },
                {
                  "value": "em",
                  "title": "Italic"
                }
              ]
            },
            "lists": [
              {
                "value": "bullet",
                "title": "Bullet"
              },
              {
                "value": "number",
                "title": "Numbered"
              }
            ],
            "styles": [
              {
                "value": "normal",
                "title": "Normal"
              },
              {
                "value": "h2",
                "title": "Heading"
              },
              {
                "value": "h3",
                "title": "Subheading"
              },
              {
                "value": "blockquote",
                "title": "Quote"
              }
            ],
            "of": [],
            "type": "block"
          },
          {
            "options": {
              "hotspot": true
            },
            "fields": [
              {
                "name": "alt",
                "type": "string",
                "title": "Alt text"
              }
            ],
            "type": "image"
          }
        ],
        "name": "body",
        "type": "array",
        "title": "Content"
      }
    ],
    "name": "post",
    "type": "document",
    "title": "Blog post"
  }
]