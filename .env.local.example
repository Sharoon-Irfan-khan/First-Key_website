# Copy this file to .env.local and fill in the values.

# --- Sanity CMS ---
# Find these at https://sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Google (Search Console / Tag Manager / Analytics) ---
# Google Tag Manager container id, from tagmanager.google.com (looks like GTM-XXXXXXX).
# Recommended: set only this, and add GA4 as a tag INSIDE GTM.
NEXT_PUBLIC_GTM_ID=GTM-MJ5JNR3L

# GA4 measurement id, from analytics.google.com → Admin → Data streams (G-XXXXXXXXXX).
# Only fill this in if you are NOT loading GA4 through GTM — otherwise every
# pageview is counted twice.
NEXT_PUBLIC_GA_ID=G-9Y7GE2YBSX

# Search Console "HTML tag" verification code — just the content value, e.g.
# for <meta name="google-site-verification" content="abc123"> paste abc123.
# Leave blank if you verified the domain through a DNS TXT record instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Email delivery (contact / careers / property forms) ---
# Pick ONE method. If both are filled in, SMTP is used.
#
# METHOD 1 — SMTP (recommended). You can send through ANY mailbox, including a
# plain Gmail account — the form emails are simply *sent* from it and delivered
# to CONTACT_TO / CAREERS_TO / LISTINGS_TO below.
# Common providers:
#   Gmail / Google Workspace : host smtp.gmail.com     port 465 (or 587)
#   Zoho Mail                : host smtp.zoho.com       port 465
#   Microsoft 365            : host smtp.office365.com   port 587
# SMTP_PASS must be an "App Password", NOT your normal login password. For
# Gmail: turn on 2-Step Verification, then Google Account → Security →
# App passwords → generate one and paste the 16 characters here (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=get.muhammad5@gmail.com
SMTP_FROM="First key International  <get.muhammad5@gmail.com>"
CONTACT_FORM_TO=info@firstkeyint.com
# The "From" shown on outgoing mail. With Gmail it must be that same Gmail
# address (Gmail won't let you send as an address you don't own).
SMTP_PASS=oiwz rnji abxu cjbk
# METHOD 2 — Resend API (fallback, only used if SMTP_HOST is blank).
# Sign up at https://resend.com, verify firstkeyint.com, create an API key.


# Where each type of submission is DELIVERED. This must be an inbox that
# actually receives mail. Each can be a single address or several separated
# by commas, e.g.  vishal@gmail.com,info@gmail.com
# NOTE: firstkeyint.com has no mailboxes yet — until it does, point these at a
# real inbox you check (a Gmail is fine), then switch them over later.
CONTACT_TO=info@firstkeyint.com
CAREERS_TO=careers@firstkeyint.com
LISTINGS_TO=vishal@firstkeyint.com
